abi <abi/4.0>,
include <tunables/global>

# Profile for task containers with 'sandbox=on' (docker run --security-opt apparmor=workstation-sandbox).
# No attachment path: it confines nothing on the host unless a container asks for it by name.
# Close to docker-default, but allows what Claude Code's sandbox (nested bubblewrap) needs: userns,
# mount, pivot_root. Programs exec'd inside inherit it, so the host's bwrap-userns-restrict profile
# never attaches to the container's /usr/bin/bwrap.
profile workstation-sandbox flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  userns,
  signal,
  ptrace (trace,read,tracedby,readby) peer=workstation-sandbox,
  unix,

  # Same /proc and /sys protections as docker-default.
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
